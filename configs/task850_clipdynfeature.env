#!/usr/bin/env bash
# TPUS release modification: machine-specific paths were replaced by portable defaults.

TPUS_CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

: "${MT_CLIP_PROMPT_SOURCE:=clip_text}"
: "${MT_CLIP_PROMPT_MODEL:=ViT-B/32}"
: "${MT_CLIP_PROMPT_DEVICE:=cpu}"
: "${MT_CLIP_PROMPT_TEXTS_JSON:=${TPUS_CONFIG_DIR}/task850_prompt_texts.json}"
: "${MT_FAITHFUL_CLIP_PROMPT_CACHE:=${XDG_CACHE_HOME:-${HOME}/.cache}/tpus/task850_clip_prompt_cache_raw_vitb32.pt}"

export MT_CLIP_PROMPT_SOURCE
export MT_CLIP_PROMPT_MODEL
export MT_CLIP_PROMPT_DEVICE
export MT_CLIP_PROMPT_TEXTS_JSON
export MT_FAITHFUL_CLIP_PROMPT_CACHE

unset TPUS_CONFIG_DIR
